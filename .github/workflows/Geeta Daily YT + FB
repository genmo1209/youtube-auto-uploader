name: Auto Upload Shorts (YouTube + Facebook)

on:
  schedule:
    - cron: "30 3 * * *"   # 9:00 AM IST
    - cron: "0 14 * * *"   # 7:30 PM IST
  workflow_dispatch:

jobs:
  upload:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      # ==============================
      # YOUTUBE UPLOAD
      # ==============================
      - name: Run YouTube uploader
        run: python upload.py
        env:
          FOLDER_ID: ${{ secrets.FOLDER_ID }}
          UPLOADED_FOLDER_ID: ${{ secrets.UPLOADED_FOLDER_ID }}
          YOUTUBE_REFRESH_TOKEN: ${{ secrets.YOUTUBE_REFRESH_TOKEN }}
          CLIENT_ID: ${{ secrets.CLIENT_ID }}
          CLIENT_SECRET: ${{ secrets.CLIENT_SECRET }}
          SERVICE_ACCOUNT_JSON: ${{ secrets.SERVICE_ACCOUNT_JSON }}

      # ==============================
      # FACEBOOK UPLOAD
      # ==============================
      - name: Run Facebook uploader
        run: python fb.py
        env:
          FOLDER_ID: ${{ secrets.FOLDER_ID }}
          UPLOADED_FOLDER_ID: ${{ secrets.UPLOADED_FOLDER_ID }}
          SERVICE_ACCOUNT_JSON: ${{ secrets.SERVICE_ACCOUNT_JSON }}
          FACEBOOK_PAGE_ID: ${{ secrets.FACEBOOK_PAGE_ID }}
          FACEBOOK_PAGE_ACCESS_TOKEN: ${{ secrets.FACEBOOK_PAGE_ACCESS_TOKEN }}

      # ==============================
      # COMMIT EPISODE UPDATE
      # ==============================
      - name: Commit updated episode number
        run: |
          git config --global user.name "github-actions"
          git config --global user.email "github-actions@github.com"
          git add episode.txt
          git commit -m "Auto upload completed" || echo "No changes to commit"
          git push
